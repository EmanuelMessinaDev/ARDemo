    m_Items: []
  m_TableData:
  - m_Id: 5960564736
    m_Localized: Insert the filter basket into the strainer until it seats
    m_Metadata:
      m_Items: []
  - m_Id: 79889367040
    m_Localized: Close the hinged cover and tighten the bolts with the cordless screwdriver
    m_Metadata:
      m_Items: []
  - m_Id: 251338311532544
    m_Localized: Close the cover
    m_Metadata:
      m_Items: []
  - m_Id: 251479336615936
    m_Localized: Tighten all the bolts with the cordless screwdriver
    m_Metadata:
      m_Items: []
  - m_Id: 367684609310720
    m_Localized: Turn the main disconnector ON (rotate clockwise)
    m_Metadata:
      m_Items: []
  - m_Id: 371496120156160
    m_Localized: 'Open the suction gate valve: turn the handwheel counter-clockwise,
      using both hands'
    m_Metadata:
      m_Items: []
  - m_Id: 604815659302912
    m_Localized: Press the RESET button to clear the alarm
    m_Metadata:
      m_Items: []
  - m_Id: 728793438683136
    m_Localized: Enable Pump 1, then press the green START P1 button
    m_Metadata:
      m_Items: []
  - m_Id: 745817137152000
    m_Localized: Slowly open the butterfly valve - turn the lever a quarter turn
    m_Metadata:
      m_Items: []
  - m_Id: 746014445600768
    m_Localized: Enable Pump 2, then press the green START P2 button
    m_Metadata:
      m_Items: []
  references:
    version: 2
